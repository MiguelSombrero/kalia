{
  "permissions": {
    "deny": [
      "Edit(./packages/api/src/generated/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && node \"$root/scripts/prune-worktrees.mjs\" || true",
            "timeout": 60,
            "statusMessage": "Removing worktrees whose pull request merged"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && node \"$root/scripts/hooks/post-edit-check.mjs\" || true",
            "timeout": 20,
            "statusMessage": "Running repository checkers"
          }
        ]
      }
    ]
  }
}
