# OS
.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Environment
.env
.env.local

# Generated build output (e.g. Spring Modulith metadata export)
build/

# Logs
*.log

# Local CLI state (e.g. gh device id) — per-machine, never shared
.local/

# Per-session agent worktrees (see CLAUDE.md "Parallel sessions") — a working
# checkout each, never shared history
.claude/worktrees/

# AI-agent working docs (superpowers skill: brainstorming companion,
# specs, implementation plans) — process scratch, not project
# documentation. Durable design decisions belong in docs/ (ADRs,
# architecture.md, README convention bullets), not here.
.superpowers/
docs/superpowers/

# Playwright writes here when run from the repository root rather than frontend/.
/test-results/
/playwright-report/
