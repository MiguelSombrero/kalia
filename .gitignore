# Dependencies: one node_modules at the root, hoisted over every workspace
# (ADR-0092), and any workspace's own when npm cannot hoist a version
node_modules/

# OS
.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Environment
.env
.env.local

# Generated build output (e.g. Spring Modulith metadata export)
build/

# Logs
*.log

# Local CLI state (e.g. gh device id) — per-machine, never shared
.local/

# Per-session agent worktrees (see CLAUDE.md "Parallel sessions") — a working
# checkout each, never shared history
.claude/worktrees/

# Session checkpoint written before long or fanned-out work (ADR-0045) — the
# resume point for an interrupted session, never part of the change it
# describes
.claude/session-checkpoint.md

# Loose agent drafts directly under .claude/ (a pull request description
# written for `gh pr create --body-file`, notes) — scratch for one session.
# The tracked Markdown here lives in rules/ and skills/, which this does not
# reach.
.claude/*.md

# AI-agent working docs (superpowers skill: brainstorming companion,
# specs, implementation plans) — process scratch, not project
# documentation. Durable design decisions belong in docs/ (ADRs,
# architecture.md, README convention bullets), not here.
.superpowers/
docs/superpowers/

# Screen captures — never shared (CLAUDE.md, ADR-0062). macOS writes the first
# two by default; a directory named for them is the other likely home.
Screenshot*
Screen Shot*
screenshots/

# Every raster image, wherever it lands, so `git add -A` skips a capture before
# it is committed — scripts/check-no-raster-images.mjs only notices once git
# already tracks one, and by CI the push has published it. A directory of
# raster assets the project ships is un-ignored here with `!dir/**` in the same
# diff that adds it to that script's ALLOWED_DIRS.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[aA][vV][iI][fF]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]

# Playwright writes here when run from the repository root rather than web/.
/test-results/
/playwright-report/
