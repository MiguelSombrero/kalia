# Dev values for every secret docker-compose.base.yml requires, applied only
# through docker-compose.yml (ADR-0089). None of them is a credential: the
# stack they open is bound to the loopback interface. Never copy one into a
# deployment; verifyRequiredConfiguration refuses the AUTH_SECRET outside the
# dev stack.
POSTGRES_PASSWORD=kalia
DATABASE_OWNER_PASSWORD=kalia-dev-owner-password
DATABASE_PASSWORD=kalia-dev-app-password
KEYCLOAK_DB_PASSWORD=kalia-dev-keycloak-db-password
FEED_CURSOR_KEY=kalia-dev-feed-cursor-key-not-a-credential
AUTH_SECRET=kalia-dev-auth-secret
METRICS_TOKEN=kalia-dev-metrics-token
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SSL_REQUIRED=none
VALKEY_PASSWORD=kalia-dev-valkey-password
# Keycloak's mail goes to the mailpit service in docker-compose.override.yml,
# which needs no auth or TLS.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@kalia.test
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false
# The password of the development admin, `testadmin`, seeded with the admin
# role by the local stack's keycloak-seed (ADR-0101). The base file seeds
# none and does not read this; docker-compose.override.yml spells the same
# value as a default, and scripts/check-compose.mjs fails if they differ.
KALIA_DEV_ADMIN_PASSWORD=testadmin123
