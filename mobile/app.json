{
  "expo": {
    "name": "Kalia",
    "slug": "kalia",
    "scheme": "kalia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fi.kalia.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "fi.kalia.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fi"],
            "android": ["en", "fi"]
          }
        }
      ],
      "./plugins/withE2eCleartext"
    ]
  }
}
