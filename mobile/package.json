{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "assets": "node scripts/render-assets.mjs",
    "preios": "npm run assets",
    "ios": "expo run:ios",
    "preios:prebuild": "npm run assets",
    "ios:prebuild": "expo prebuild --platform ios",
    "preandroid": "npm run assets",
    "android": "expo run:android",
    "preandroid:prebuild": "npm run assets",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "lint": "eslint && tsc --noEmit",
    "test": "jest && node --test scripts/render-assets.test.mjs scripts/app-config.test.mjs scripts/check-cleartext.test.mjs plugins/withCleartextExceptions.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@hookform/resolvers": "^6.0.2",
    "@kalia/api": "*",
    "@kalia/locales": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.7.2",
    "react": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "eslint": "^10",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-boundaries": "7.4.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "sharp": "^0.35.0",
    "typescript": "^7.0.2"
  }
